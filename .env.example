# Postgres (Supabase transaction pooler, port 6543 — required for serverless)
DATABASE_URL=postgresql://postgres.<ref>:<db-password>@aws-1-<region>.pooler.supabase.com:6543/postgres

# Session pooler (port 5432) — used only by `npm run db:push`
MIGRATION_DATABASE_URL=postgresql://postgres.<ref>:<db-password>@aws-1-<region>.pooler.supabase.com:5432/postgres

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Admin dashboard passcode
ADMIN_PASSCODE=

# Public base URL of the deployment (used in Telegram message links)
APP_URL=https://your-app.vercel.app

# Bot username (no @) — used in links and messages
TELEGRAM_BOT_USERNAME=
NEXT_PUBLIC_BOT_USERNAME=
